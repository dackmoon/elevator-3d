# 硅基流动（SiliconFlow）API 配置
# 请复制为 .env.local 并填入你的真实 API Key（.env.local 已被 .gitignore 忽略，不会泄露）

# 必填：你的硅基流动 API Key（以 sk- 开头）
SILICONFLOW_API_KEY=

# 生图模型名称（推荐 Qwen/Qwen-Image 支持 1664x928 宽幅，也可改为 Kwai-Kolors/Kolors）
SILICONFLOW_MODEL=Qwen/Qwen-Image

# 图像分辨率：Qwen/Qwen-Image 推荐 1664x928 (16:9)；Kwai-Kolors/Kolors 推荐 1024x1024
SILICONFLOW_IMAGE_SIZE=1664x928

# 推理步数（Qwen-Image 推荐 30~50；Kolors 推荐 20~30）
SILICONFLOW_STEPS=35

# CFG / Guidance Scale（Qwen-Image 使用 cfg 默认 4.0；Kolors 使用 guidance_scale 默认 7.5）
SILICONFLOW_CFG=4.0

# API 地址（默认即可，一般无需修改）
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/images/generations

# 语音合成（TTS）模型与音色配置（用于电梯语音播报）
SILICONFLOW_TTS_URL=https://api.siliconflow.cn/v1/audio/speech
SILICONFLOW_TTS_MODEL=fnlp/MOSS-TTSD-v0.5
SILICONFLOW_TTS_VOICE=fnlp/MOSS-TTSD-v0.5:alex
